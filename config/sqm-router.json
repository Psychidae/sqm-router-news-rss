{
  "app": {
    "title": "SQMルーター関連ニュース",
    "timezone": "Asia/Tokyo",
    "lookback_hours": 168,
    "max_items": 15,
    "summary_chars": 220,
    "state_path": ".state/sent_items.json",
    "state_retention_days": 60,
    "send_empty": false,
    "env_file": ".env",
    "request_timeout_seconds": 25,
    "user_agent": "sqm-router-news-slack/0.1"
  },
  "slack": {
    "webhook_env": "SLACK_WEBHOOK_URL",
    "username": "SQM News"
  },
  "filters": {
    "required_any": [
      "SQM",
      "Smart Queue Management",
      "luci-app-sqm",
      "sqm-scripts",
      "bufferbloat",
      "CAKE",
      "cake-autorate",
      "fq_codel",
      "fq-codel",
      "sch_cake",
      "qdisc",
      "active queue management",
      "AQM",
      "latency under load",
      "LibreQoS",
      "queue management"
    ],
    "exclude_any": [
      "stock price",
      "earnings call",
      "sqm lithium",
      "sqm stock",
      "sociedad química",
      "lithium mining"
    ],
    "score_terms": [
      "SQM",
      "Smart Queue Management",
      "OpenWrt",
      "luci-app-sqm",
      "sqm-scripts",
      "bufferbloat",
      "CAKE",
      "cake-autorate",
      "fq_codel",
      "fq-codel",
      "sch_cake",
      "qdisc",
      "active queue management",
      "AQM",
      "latency under load",
      "LibreQoS",
      "QoS",
      "router"
    ]
  },
  "sources": [
    {
      "name": "Google News: SQM / OpenWrt",
      "type": "google_news",
      "enabled": true,
      "query": "(\"SQM router\" OR \"OpenWrt SQM\" OR \"Smart Queue Management\" OR \"luci-app-sqm\" OR \"sqm-scripts\")"
    },
    {
      "name": "Google News: bufferbloat / AQM",
      "type": "google_news",
      "enabled": true,
      "query": "(bufferbloat OR \"latency under load\" OR \"active queue management\" OR AQM) (router OR OpenWrt OR Wi-Fi OR broadband)"
    },
    {
      "name": "Google News: CAKE / fq_codel",
      "type": "google_news",
      "enabled": true,
      "query": "(\"CAKE qdisc\" OR \"sch_cake\" OR \"cake-autorate\" OR \"fq_codel\" OR \"fq-codel\") (router OR OpenWrt OR Linux OR QoS)"
    },
    {
      "name": "Google News: LibreQoS / latency",
      "type": "google_news",
      "enabled": true,
      "query": "(LibreQoS OR \"Smart Queue Management\" OR bufferbloat) (router OR ISP OR latency OR broadband)"
    },
    {
      "name": "Google News: Japanese web",
      "type": "google_news",
      "enabled": true,
      "query": "(SQM OR \"Smart Queue Management\" OR bufferbloat OR バッファブロート OR cake-autorate) (ルーター OR OpenWrt OR QoS)"
    },
    {
      "name": "Bing News: SQM / OpenWrt",
      "type": "rss",
      "enabled": true,
      "url": "https://www.bing.com/news/search?q=%22OpenWrt%20SQM%22%20OR%20%22SQM%20router%22%20OR%20%22Smart%20Queue%20Management%22%20OR%20%22luci-app-sqm%22&format=rss"
    },
    {
      "name": "Bing News: bufferbloat / CAKE",
      "type": "rss",
      "enabled": true,
      "url": "https://www.bing.com/news/search?q=bufferbloat%20router%20OR%20%22CAKE%20qdisc%22%20OR%20%22cake-autorate%22%20OR%20%22fq_codel%22&format=rss"
    },
    {
      "name": "OpenWrt releases",
      "type": "rss",
      "enabled": true,
      "url": "https://github.com/openwrt/openwrt/releases.atom",
      "required_any": [
